# One keeper command per instance: prescient@tick, prescient@daily, prescient@baseline, prescient@watchdog.
# Secrets come from an encrypted systemd credential (systemd-creds), decrypted only for this process.
[Unit]
Description=PRESCIENT keeper %i (BSC mainnet)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=prescient
Group=prescient
WorkingDirectory=/opt/prescient/app
LoadCredentialEncrypted=keeper.env:/etc/prescient/keeper.env.cred
ExecStart=/bin/sh -c 'exec /opt/prescient/node/bin/node --env-file="$CREDENTIALS_DIRECTORY/keeper.env" keeper/keeper.mjs %i --network mainnet'
TimeoutStartSec=50min
# hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/prescient/app/keeper/state /opt/prescient/app/keeper/archive
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
UMask=0077
